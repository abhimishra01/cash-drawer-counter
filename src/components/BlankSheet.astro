---
import { DENOMS } from '../lib/drawer.js';
---
<div class="blank-sheet" id="blank-sheet">
  <h2 class="bs-title">Cash register count sheet</h2>
  <div class="bs-head">
    <span>Date: <i></i></span><span>Cashier: <i></i></span><span>Register no.: <i></i></span><span>Shift: <i></i></span>
  </div>
  <table class="bs-table">
    <thead>
      <tr><th rowspan="2" class="bs-left">Bills and coins</th><th colspan="2">Opening</th><th colspan="2">Closing</th></tr>
      <tr><th>Count</th><th>Amount</th><th>Count</th><th>Amount</th></tr>
    </thead>
    <tbody>
      {DENOMS.map((d) => <tr><td class="bs-left">{d.label}</td><td></td><td></td><td></td><td></td></tr>)}
      <tr class="bs-total"><td class="bs-left">Total</td><td></td><td></td><td></td><td></td></tr>
    </tbody>
  </table>
  <table class="bs-table bs-calc">
    <tbody>
      <tr><td class="bs-left">Starting float</td><td></td></tr>
      <tr><td class="bs-left">+ Cash sales (from the register report)</td><td></td></tr>
      <tr><td class="bs-left">- Paid-outs</td><td></td></tr>
      <tr><td class="bs-left">= Expected cash in the drawer</td><td></td></tr>
      <tr><td class="bs-left">Counted in the drawer (closing total)</td><td></td></tr>
      <tr><td class="bs-left">Over (+) or short (-)</td><td></td></tr>
      <tr><td class="bs-left">Cash to deposit (closing total - float)</td><td></td></tr>
    </tbody>
  </table>
  <div class="bs-sign"><span>Counted by: <i></i></span><span>Checked by: <i></i></span><span>Date: <i></i></span></div>
</div>

<style is:global>
  .blank-sheet { background: #fff; color: #111; border: 1px solid #c9ccc6; border-radius: 6px; padding: 1.25rem 1.5rem; max-width: 46rem; font: 13px/1.3 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
  .bs-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 .6rem; }
  .bs-head, .bs-sign { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; margin: 0 0 .75rem; }
  .bs-head span, .bs-sign span { flex: 1 1 8rem; display: flex; gap: .4rem; align-items: flex-end; white-space: nowrap; }
  .bs-head i, .bs-sign i { flex: 1; border-bottom: 1px solid #111; min-width: 3rem; height: 1em; }
  .bs-sign { margin: .9rem 0 0; }
  .bs-table { width: 100%; border-collapse: collapse; margin: 0 0 .75rem; }
  .bs-table th, .bs-table td { border: 1px solid #111; padding: 0 .4rem; height: 1.7rem; text-align: center; font-weight: 400; }
  .bs-table thead th { font-weight: 700; height: 1.5rem; background: #f0f0f0; }
  .bs-table .bs-left { text-align: left; }
  .bs-table tbody td.bs-left { width: 40%; }
  .bs-total td { font-weight: 700; background: #f0f0f0; }
  .bs-calc td.bs-left { width: 72%; }
  @media print {
    @page { size: letter; margin: 0.5in; }
    .blank-sheet { border: 0; border-radius: 0; padding: 0; max-width: none; font-size: 11pt; }
    .bs-table th, .bs-table td { height: 0.27in; }
    .bs-table thead th { height: 0.24in; }
  }
</style>
