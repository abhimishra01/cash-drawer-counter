---
import { DENOMS } from '../lib/drawer.js';
const groups = ['Bills', 'Coins', 'Rolls'].map((g) => ({ name: g, rows: DENOMS.filter((d) => d.group === g) }));
const field = 'block rounded-xl border border-line bg-paper px-3 text-lg font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30';
const step = 'row-span-2 sm:row-span-1 flex h-12 w-11 sm:w-12 shrink-0 items-center justify-center rounded-xl border border-line bg-paper text-2xl font-bold leading-none select-none active:bg-brand-soft hover:bg-brand-soft';
---
<section id="tool" aria-label="Cash drawer counter" class="rounded-2xl border border-line bg-card p-4 sm:shadow-[6px_6px_0_0_var(--line)] sm:p-6">
  <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr]">
    <div id="rows" class="space-y-5">
      {groups.map((g) => (
        <fieldset>
          <legend class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">{g.name}</legend>
          <div class="space-y-2">
            {g.rows.map((d) => (
              <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-2 sm:grid-cols-[1fr_auto_auto_auto_6rem]" data-row={d.id}>
                <label for={`in-${d.id}`} class="col-start-1 row-start-1 min-w-0 self-end text-sm font-medium leading-tight sm:self-center sm:text-base">{d.label}</label>
                <button type="button" class={step} data-step="-1" data-for={d.id} aria-label={`One fewer ${d.label}`}>&minus;</button>
                <input id={`in-${d.id}`} data-count={d.id} type="text" inputmode="numeric" pattern="[0-9]*" enterkeyhint="next" autocomplete="off" placeholder="0" class={`${field} row-span-2 sm:row-span-1 h-12 w-16 text-center sm:w-20`} />
                <button type="button" class={step} data-step="1" data-for={d.id} aria-label={`One more ${d.label}`}>+</button>
                <output data-total={d.id} class="col-start-1 row-start-2 self-start font-mono text-xs tabular-nums text-muted sm:col-start-5 sm:row-start-1 sm:self-center sm:text-right sm:text-sm">$0.00</output>
              </div>
            ))}
          </div>
        </fieldset>
      ))}
    </div>

    <div class="space-y-4 lg:sticky lg:top-20 lg:self-start">
      <div class="rounded-xl bg-brand-soft p-4">
        <p class="text-xs font-medium text-muted">Total in drawer</p>
        <p id="grand" class="font-mono text-4xl font-extrabold tabular-nums text-brand-ink" aria-live="polite">$0.00</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="float" class="text-sm font-semibold">Starting float</label>
          <input id="float" type="text" inputmode="decimal" enterkeyhint="next" autocomplete="off" placeholder="200.00" class={`${field} mt-1 h-12 w-full`} />
        </div>
        <div>
          <label for="sales" class="text-sm font-semibold">Expected sales <span class="font-normal text-muted">(optional)</span></label>
          <input id="sales" type="text" inputmode="decimal" enterkeyhint="done" autocomplete="off" placeholder="0.00" class={`${field} mt-1 h-12 w-full`} />
        </div>
      </div>
      <div id="results" class="space-y-3 rounded-xl border border-line p-4" aria-live="polite">
        <div class="flex items-baseline justify-between gap-3"><span class="text-sm font-semibold">Cash to deposit</span><span id="dep" class="font-mono text-2xl font-bold tabular-nums">$0.00</span></div>
        <div id="ovs-wrap" class="hidden flex-wrap items-baseline justify-between gap-3"><span id="ovs-label" class="text-sm font-semibold"></span><span id="ovs" class="font-mono text-xl font-bold tabular-nums"></span></div>
        <div id="pull-wrap" class="hidden border-t border-line pt-3">
          <p class="text-sm font-semibold">Pull for the deposit</p>
          <ul id="pull" class="mt-1 space-y-0.5 text-sm tabular-nums"></ul>
          <p id="pull-note" class="mt-2 text-sm text-red-700 dark:text-red-400"></p>
        </div>
        <p id="hint" class="text-sm text-muted">Enter a starting float to see what to pull and what to leave.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="copy" class="h-12 flex-1 rounded-xl bg-brand px-4 font-semibold text-white hover:opacity-90">Copy summary</button>
        <button type="button" id="print" class="h-12 rounded-xl border border-line px-4 font-semibold hover:bg-brand-soft">Print</button>
        <button type="button" id="reset" class="h-12 rounded-xl border border-line px-4 font-semibold hover:bg-brand-soft">Reset</button>
      </div>
      <p id="status" class="min-h-5 text-sm text-muted" role="status"></p>
    </div>
  </div>
  <div class="fixed inset-x-0 bottom-0 z-10 flex items-baseline justify-between border-t border-line bg-card/95 px-4 py-2 backdrop-blur lg:hidden" aria-hidden="true">
    <span class="text-sm font-medium text-muted">Total in drawer</span>
    <span id="grand-bar" class="font-mono text-xl font-extrabold tabular-nums text-brand-ink">$0.00</span>
  </div>
  <pre id="sheet" class="print-only" aria-hidden="true"></pre>
</section>

<style is:global>
  .print-only { display: none; }
  @media print {
    body * { visibility: hidden !important; }
    #sheet, #sheet * { visibility: visible !important; }
    #sheet { display: block; position: absolute; left: 0; top: 0; font: 14px/1.5 ui-monospace, Menlo, Consolas, monospace; color: #000; white-space: pre-wrap; }
  }
  #ovs-wrap.flex { display: flex; }
</style>

<script>
  import { DENOMS, parseCents, formatCents, grandTotal, pickFloat, deposit } from '../lib/drawer.js';

  const $ = (id: string) => document.getElementById(id)!;
  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-count]'));
  const floatEl = $('float') as HTMLInputElement;
  const salesEl = $('sales') as HTMLInputElement;
  const KEY = 'cdc-float';

  const counts = (): Record<string, number> => {
    const c: Record<string, number> = {};
    for (const i of inputs) c[i.dataset.count!] = parseInt(i.value.replace(/\D/g, ''), 10) || 0;
    return c;
  };
  const label = (id: string) => DENOMS.find((d) => d.id === id)!.label;
  const lines = (m: Record<string, number>) =>
    DENOMS.filter((d) => m[d.id]).map((d) => `${m[d.id]} x ${d.label}`);

  let summaryText = '';

  function update() {
    const c = counts();
    for (const d of DENOMS) $(`in-${d.id}`).parentElement!.querySelector<HTMLElement>('[data-total]')!.textContent = formatCents(d.cents * c[d.id]);
    const total = grandTotal(c);
    $('grand').textContent = formatCents(total);
    $('grand-bar').textContent = formatCents(total);

    const flt = parseCents(floatEl.value);
    const sales = parseCents(salesEl.value);
    const pullWrap = $('pull-wrap'), hint = $('hint'), note = $('pull-note');
    let dep = total, pickInfo: ReturnType<typeof pickFloat> | null = null, pulled: Record<string, number> = {};
    if (flt !== null) {
      dep = Math.max(0, total - flt);
      pickInfo = pickFloat(c, flt);
      pulled = deposit(c, pickInfo.keep);
      const ul = $('pull'); ul.innerHTML = '';
      for (const t of lines(pulled)) { const li = document.createElement('li'); li.textContent = t; ul.appendChild(li); }
      if (!ul.children.length) { const li = document.createElement('li'); li.textContent = 'Nothing to pull.'; ul.appendChild(li); }
      note.textContent = total < flt
        ? `The drawer is ${formatCents(flt - total)} under the float.`
        : pickInfo.missing > 0 ? `Cannot make the float exactly with this cash. ${formatCents(pickInfo.missing)} short; adjust by hand.` : '';
      pullWrap.classList.remove('hidden'); hint.classList.add('hidden');
    } else {
      pullWrap.classList.add('hidden'); hint.classList.remove('hidden');
    }
    $('dep').textContent = formatCents(dep);

    const ovsWrap = $('ovs-wrap'), ovs = $('ovs'), ovsLabel = $('ovs-label');
    let diffText = '';
    if (sales !== null && flt !== null) {
      const diff = total - flt - sales;
      ovsWrap.classList.add('flex'); ovsWrap.classList.remove('hidden');
      ovs.className = 'font-mono text-xl font-bold tabular-nums ' + (diff === 0 ? 'text-green-700 dark:text-green-400' : diff > 0 ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400');
      ovsLabel.textContent = diff === 0 ? 'Balanced' : diff > 0 ? 'Over' : 'Short';
      ovs.textContent = diff === 0 ? '$0.00' : formatCents(Math.abs(diff));
      diffText = diff === 0 ? 'Balanced ($0.00)' : `${diff > 0 ? 'Over' : 'Short'} ${formatCents(Math.abs(diff))}`;
    } else if (sales !== null) {
      ovsWrap.classList.add('flex'); ovsWrap.classList.remove('hidden');
      const diff = total - sales;
      ovs.className = 'font-mono text-xl font-bold tabular-nums ' + (diff >= 0 ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400');
      ovsLabel.textContent = diff === 0 ? 'Balanced' : diff > 0 ? 'Over' : 'Short';
      ovs.textContent = diff === 0 ? '$0.00' : formatCents(Math.abs(diff));
      diffText = diff === 0 ? 'Balanced ($0.00)' : `${diff > 0 ? 'Over' : 'Short'} ${formatCents(Math.abs(diff))}`;
    } else { ovsWrap.classList.add('hidden'); ovsWrap.classList.remove('flex'); }

    const out = ['CASH DRAWER COUNT', new Date().toLocaleString('en-US'), ''];
    out.push(...DENOMS.filter((d) => c[d.id]).map((d) => `${label(d.id).padEnd(22)} ${String(c[d.id]).padStart(4)}  ${formatCents(d.cents * c[d.id]).padStart(11)}`));
    out.push('', `Total in drawer: ${formatCents(total)}`);
    if (flt !== null) out.push(`Starting float: ${formatCents(flt)}`);
    out.push(`Cash to deposit: ${formatCents(dep)}`);
    if (sales !== null) out.push(`Expected sales: ${formatCents(sales)}`);
    if (diffText) out.push(diffText);
    if (flt !== null && Object.keys(pulled).length) out.push('', 'Pull for the deposit:', ...lines(pulled).map((l) => '  ' + l));
    summaryText = out.join('\n');
    $('sheet').textContent = summaryText;
  }

  function stepRow(id: string, delta: number) {
    const el = $(`in-${id}`) as HTMLInputElement;
    el.value = String(Math.max(0, (parseInt(el.value, 10) || 0) + delta));
    update();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => stepRow(b.dataset.for!, parseInt(b.dataset.step!, 10))));

  const order: HTMLInputElement[] = [...inputs, floatEl, salesEl];
  order.forEach((el, i) => {
    el.addEventListener('input', () => {
      if (el.dataset.count) el.value = el.value.replace(/\D/g, '').slice(0, 6);
      if (el === floatEl) { try { localStorage.setItem(KEY, el.value); } catch {} }
      update();
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); (order[i + 1] ?? el).focus(); (order[i + 1] ?? el).select?.(); }
      if (el.dataset.count && e.key === 'ArrowUp') { e.preventDefault(); stepRow(el.dataset.count, 1); }
      if (el.dataset.count && e.key === 'ArrowDown') { e.preventDefault(); stepRow(el.dataset.count, -1); }
    });
    el.addEventListener('focus', () => el.select());
  });

  const status = (t: string) => { $('status').textContent = t; setTimeout(() => { if ($('status').textContent === t) $('status').textContent = ''; }, 3000); };
  $('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(summaryText); status('Summary copied.'); }
    catch { status('Could not copy. Use Print instead.'); }
  });
  $('print').addEventListener('click', () => window.print());
  $('reset').addEventListener('click', () => {
    inputs.forEach((i) => (i.value = '')); salesEl.value = '';
    update(); status('Counts cleared. The float is kept.');
  });

  try { const f = localStorage.getItem(KEY); if (f) floatEl.value = f; } catch {}
  update();
</script>
