---
import Base from '../layouts/Base.astro';
import BlankSheet from '../components/BlankSheet.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { url } from '../lib/url.ts';
import site from '../site.config.ts';

const faq = [
  { q: 'Is the cash register count sheet free?', a: 'Yes. Press Print blank sheet, or choose Save as PDF in the print window. There is no signup and nothing is sent anywhere.' },
  { q: 'Does it print on one page?', a: 'Yes. The sheet is set for US Letter paper with half-inch margins and fits on one page.' },
  { q: 'Do I need the paper sheet if I use the calculator?', a: 'No. The calculator prints its own filled sheet with a signature line. Use the blank sheet when you count by hand or when your manager wants a paper form.' },
];
const base = site.origin;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Cash register count sheet', url: `${base}/cash-register-count-sheet/`, inLanguage: site.locale },
];
---
<Base
  fullTitle="Cash Register Count Sheet | Free Printable Cash Drawer Count Sheet"
  description="A free printable cash register count sheet with opening and closing columns, over and short, and signature lines. Prints on one Letter page."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">Cash register count sheet</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">A free sheet to count a cash drawer by hand. It has opening and closing columns, an over and short section, and lines to sign. It prints on one US Letter page.</p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button type="button" id="print-blank" class="h-12 rounded-xl bg-brand px-5 font-semibold text-white hover:opacity-90">Print blank sheet</button>
      <a href={url()} class="flex h-12 items-center rounded-xl border border-edge px-5 font-semibold no-underline hover:bg-brand-soft">Count online instead</a>
    </div>
    <p class="mt-2 text-sm text-muted">To save a PDF, press Print and choose Save as PDF in the print window.</p>
  </section>

  <section id="sheet-wrap" class="mx-auto max-w-5xl px-4 pt-8">
    <p class="no-print mb-2 text-sm text-muted">Preview of the printed page. The boxes are blank on purpose: print the sheet and fill it in by hand.</p>
    <div class="sheet-preview"><BlankSheet /></div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pt-16">
    <article class="prose-site">
      <h2 style="margin-top:0">How to fill out the count sheet</h2>
      <ol>
        <li>Write the date, your name, the register number and the shift at the top.</li>
        <li>At the start of the shift, count the drawer. Write the count of each bill and coin in the Opening column. Write the amount next to it. Add the Opening amounts at the bottom.</li>
        <li>At the end of the shift, count again and fill in the Closing columns the same way.</li>
        <li>Write the starting float. Write the cash sales from the register report and any paid-outs.</li>
        <li>Add the float and the cash sales, then subtract the paid-outs. That is the expected cash in the drawer.</li>
        <li>Subtract the expected cash from the closing total. A plus number is over. A minus number is short.</li>
        <li>Subtract the float from the closing total to get the deposit. Sign the sheet.</li>
      </ol>
      <h2>Opening and closing columns</h2>
      <p>The Opening column shows what was in the drawer when the shift began. The Closing column shows what is in it now. The opening total should equal the float. If it does not, write the difference at the top so the closing check stays fair for the next shift.</p>
      <h2>Why use a count sheet</h2>
      <p>A written count gives you proof of what was in the drawer and who counted it. If the drawer is short, the sheet shows where to look. Many shops keep the sheet with the deposit slip and the register report.</p>
      <h2>Skip the math</h2>
      <p>The sums on this sheet take time and add chances for mistakes. The <a href={url()}>cash drawer counter</a> does them for you. It also lists the bills to leave and the bills to take out for the deposit, and it prints a filled sheet.</p>
      <h2>Common questions</h2>
      {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </article>
  </section>
  <GuideLinks current="cash-register-count-sheet" />
</Base>

<style is:global>
  /* On screen the sheet is a picture of the paper form, so it must not look or act like a form. */
  .sheet-preview { pointer-events: none; user-select: none; }
  @media print {
    .no-print { display: none !important; }
    body > :not(main) { display: none !important; }
    main > :not(#sheet-wrap) { display: none !important; }
    html, body { background: #fff !important; }
    #sheet-wrap { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  }
</style>

<script>
  document.getElementById('print-blank')?.addEventListener('click', () => window.print());
</script>
