---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import PlanTable from '../components/PlanTable.astro';
import GuideLinks from '../components/GuideLinks.astro';
import site from '../site.config.ts';
import { url } from '../lib/url.ts';
import { guides, type Guide } from '../data/guides.ts';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const base = site.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication', name: g.h1, url: `${base}/${g.slug}/`, description: g.description,
    applicationCategory: site.category, operatingSystem: 'Any', inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base fullTitle={g.title} description={g.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">{g.h1}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{g.intro}</p>
    <div class="mt-8 min-h-[22rem]"><Tool presetFloat={g.presetFloat} /></div>
  </section>
  <section class="mx-auto max-w-5xl px-4 pt-16">
    <article class="prose-site">
      {g.sections.map((s, i) => (
        <>
          <h2 style={i === 0 ? 'margin-top:0' : undefined}>{s.h}</h2>
          {s.p?.map((t) => <p>{t}</p>)}
          {s.plans && <PlanTable keys={s.plans} />}
          {s.table && (
            <table class={s.table.wide ? 'wide' : undefined}>
              <thead><tr>{s.table.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{s.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
            </table>
          )}
          {s.ul && <ul>{s.ul.map((t) => <li>{t}</li>)}</ul>}
          {s.ol && <ol>{s.ol.map((t) => <li>{t}</li>)}</ol>}
        </>
      ))}
      <h2>Common questions</h2>
      {g.faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
      <p>Back to the <a href={url()}>cash drawer counter</a> home page.</p>
    </article>
  </section>
  <GuideLinks heading="Related pages" slugs={g.related} current={g.slug} />
</Base>
